#!/usr/bin/env bash

# Interactive SD card burning utility for Raspberry Pi images
# Lists available SD cards and images, confirms before burning

set -e

# Colours for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Colour

# Get the script directory and project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
DEPLOY_DIR="$PROJECT_ROOT/deploy"

print_error() {
  echo -e "${RED}Error: $1${NC}" >&2
}

print_warning() {
  echo -e "${YELLOW}Warning: $1${NC}" >&2
}

print_success() {
  echo -e "${GREEN}$1${NC}"
}

print_info() {
  echo -e "${BLUE}$1${NC}"
}

# Check if running with sudo/root
check_root() {
  if [[ $EUID -ne 0 ]]; then
    print_error "This script must be run with sudo"
    echo "Usage: sudo $0"
    exit 1
  fi
}

# List available SD cards (removable USB/MMC devices)
list_sd_cards() {
  local devices=()
  local device_info=()

  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      local name size model
      read -r name size model <<< "$line"
      devices+=("$name")
      device_info+=("$name - $size - $model")
    fi
  done < <(lsblk -d -o NAME,SIZE,MODEL -n --filter '(TRAN=="usb" || TRAN=="mmc") && RM==1 && SIZE!=0' 2>/dev/null)

  if [[ ${#devices[@]} -eq 0 ]]; then
    print_error "No SD cards or USB drives found"
    echo "Please insert an SD card and try again"
    exit 1
  fi

  echo ""
  print_info "Available SD cards/USB drives:"
  echo ""

  local i=1
  for info in "${device_info[@]}"; do
    echo "  $i) $info"
    ((i++))
  done
  echo ""

  local selection
  while true; do
    read -rp "Select a device [1-${#devices[@]}]: " selection

    if [[ "$selection" =~ ^[0-9]+$ ]] && [[ "$selection" -ge 1 ]] && [[ "$selection" -le ${#devices[@]} ]]; then
      SELECTED_DEVICE="${devices[$((selection-1))]}"
      SELECTED_DEVICE_INFO="${device_info[$((selection-1))]}"
      break
    else
      print_error "Invalid selection. Please enter a number between 1 and ${#devices[@]}"
    fi
  done
}

# List available images in deploy directory
list_images() {
  local images=()

  if [[ ! -d "$DEPLOY_DIR" ]]; then
    print_error "Deploy directory not found: $DEPLOY_DIR"
    exit 1
  fi

  while IFS= read -r -d '' img; do
    images+=("$img")
  done < <(find "$DEPLOY_DIR" -maxdepth 1 -name "*.img" -type f -print0 2>/dev/null | sort -z)

  if [[ ${#images[@]} -eq 0 ]]; then
    print_error "No .img files found in $DEPLOY_DIR"
    echo "Please build an image first using: ./build.sh"
    exit 1
  fi

  echo ""
  print_info "Available images:"
  echo ""

  local i=1
  for img in "${images[@]}"; do
    local basename
    basename=$(basename "$img")
    local size
    size=$(du -h "$img" | cut -f1)
    echo "  $i) $basename ($size)"
    ((i++))
  done
  echo ""

  local selection
  while true; do
    read -rp "Select an image [1-${#images[@]}]: " selection

    if [[ "$selection" =~ ^[0-9]+$ ]] && [[ "$selection" -ge 1 ]] && [[ "$selection" -le ${#images[@]} ]]; then
      SELECTED_IMAGE="${images[$((selection-1))]}"
      SELECTED_IMAGE_NAME=$(basename "$SELECTED_IMAGE")
      break
    else
      print_error "Invalid selection. Please enter a number between 1 and ${#images[@]}"
    fi
  done
}

# Show summary and confirm
confirm_burn() {
  echo ""
  echo "=============================================="
  print_warning "          SD CARD BURN CONFIRMATION"
  echo "=============================================="
  echo ""
  echo "  Device: /dev/$SELECTED_DEVICE"
  echo "  Info:   $SELECTED_DEVICE_INFO"
  echo ""
  echo "  Image:  $SELECTED_IMAGE_NAME"
  echo ""
  echo "=============================================="
  print_warning "  ALL DATA ON /dev/$SELECTED_DEVICE WILL BE LOST!"
  echo "=============================================="
  echo ""

  read -rp "Type 'yes' to proceed: " confirmation

  if [[ "$confirmation" != "yes" ]]; then
    print_info "Operation cancelled"
    exit 0
  fi
}

# Burn the image
burn_image() {
  echo ""
  print_info "Burning image to /dev/$SELECTED_DEVICE..."
  echo ""

  # Unmount any mounted partitions on the device
  for partition in /dev/"${SELECTED_DEVICE}"*; do
    if mountpoint -q "$partition" 2>/dev/null || mount | grep -q "^$partition "; then
      print_info "Unmounting $partition..."
      umount "$partition" 2>/dev/null || true
    fi
  done

  # Burn the image with progress
  dd if="$SELECTED_IMAGE" of="/dev/$SELECTED_DEVICE" bs=4M status=progress conv=fsync

  echo ""
  print_info "Syncing..."
  sync

  echo ""
  print_success "Image successfully burned to /dev/$SELECTED_DEVICE"
  echo ""

  # Offer to eject
  read -rp "Eject the device? [y/N]: " eject_choice
  if [[ "$eject_choice" =~ ^[Yy]$ ]]; then
    eject "/dev/$SELECTED_DEVICE" 2>/dev/null || true
    print_success "Device ejected. Safe to remove."
  else
    print_info "Remember to safely eject the device before removing."
  fi
}

# Main
main() {
  echo ""
  echo "========================================"
  echo "     Raspbocrate SD Card Burner"
  echo "========================================"

  check_root
  list_sd_cards
  list_images
  confirm_burn
  burn_image

  echo ""
  print_success "Done!"
}

main "$@"
