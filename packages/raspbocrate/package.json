{
  "name": "raspbocrate",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint:types": "tsc --noEmit",
    "db:generate": "dotenv-cli -e .env.local -- prisma generate",
    "db:push": "dotenv-cli -e .env.local -- prisma db push",
    "db:migrate": "dotenv-cli -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv-cli -e .env.local -- prisma studio",
    "db:seed": "dotenv-cli -e .env.local -- prisma db seed"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.10.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "arocapi": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.71.0",
    "nitro": "3.0.261103-rc",
    "prisma": "^7.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ro-crate": "^3.7.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv-cli": "^11.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
