---
interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;

const components = [
  {
    name: 'raspbocrate',
    description: 'React admin interface',
    colour: 'bg-blue-100 border-blue-300 text-blue-800',
  },
  {
    name: 'raspbocapi',
    description: 'Fastify RO-Crate API',
    colour: 'bg-green-100 border-green-300 text-green-800',
  },
  {
    name: 'oni-ui',
    description: 'Catalogue browser',
    colour: 'bg-purple-100 border-purple-300 text-purple-800',
  },
  {
    name: 'OpenSearch',
    description: 'Search engine',
    colour: 'bg-orange-100 border-orange-300 text-orange-800',
  },
  {
    name: 'MariaDB',
    description: 'Database',
    colour: 'bg-cyan-100 border-cyan-300 text-cyan-800',
  },
];
---

<section class={preview ? 'bg-gray-50 py-20' : ''}>
  <div class={preview ? 'container-wide' : ''}>
    {preview && (
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          Modern architecture
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Built with Docker Compose for easy deployment and management.
        </p>
      </div>
    )}

    <div class={preview ? 'mx-auto mt-12 max-w-4xl' : ''}>
      <!-- Architecture diagram -->
      <div class="rounded-xl border border-gray-200 bg-white p-8">
        <div class="mb-6 text-center">
          <span class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
            </svg>
            Raspberry Pi
          </span>
        </div>

        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
          {components.map((component) => (
            <div class={`rounded-lg border-2 p-4 text-center ${component.colour}`}>
              <div class="font-semibold">{component.name}</div>
              <div class="mt-1 text-xs opacity-75">{component.description}</div>
            </div>
          ))}
        </div>

        <div class="mt-6 flex items-center justify-center gap-2 text-sm text-gray-500">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M21.81 10.25c-.06-.04-.56-.43-1.64-.43-.42 0-.87.05-1.34.14-.45-2.98-3.02-4.27-3.16-4.34l-.63-.35-.39.6c-.5.76-.79 1.79-.72 2.77.04.5.18 1.01.43 1.47-.65.35-1.7.44-1.91.44H.62l-.04.33c-.1.78-.1 1.57 0 2.35.21 1.58.82 2.78 1.81 3.58 1.12.91 2.67 1.37 4.61 1.37.86 0 1.77-.09 2.71-.27 1.17-.23 2.29-.66 3.33-1.26.86-.5 1.64-1.13 2.3-1.88.98-1.1 1.58-2.34 2.03-3.43.19 0 .37-.01.54-.01 1.06 0 1.7-.34 2.08-.62.24-.17.44-.38.58-.62l.16-.35-.31-.21zm-16.2.32H4.12c-.18 0-.32.14-.32.32v1.71c0 .18.14.32.32.32h1.49c.18 0 .32-.14.32-.32v-1.71c0-.18-.14-.32-.32-.32zm3.82 0H7.94c-.18 0-.32.14-.32.32v1.71c0 .18.14.32.32.32h1.49c.18 0 .32-.14.32-.32v-1.71c0-.18-.14-.32-.32-.32zm3.83 0h-1.49c-.18 0-.32.14-.32.32v1.71c0 .18.14.32.32.32h1.49c.18 0 .32-.14.32-.32v-1.71c0-.18-.14-.32-.32-.32zm-7.64-3h-1.5c-.17 0-.32.14-.32.32v1.71c0 .18.15.32.32.32h1.5c.17 0 .32-.14.32-.32V7.89c0-.18-.15-.32-.32-.32zm3.82 0H7.95c-.17 0-.32.14-.32.32v1.71c0 .18.15.32.32.32h1.49c.17 0 .32-.14.32-.32V7.89c0-.18-.15-.32-.32-.32zm3.83 0h-1.49c-.18 0-.32.14-.32.32v1.71c0 .18.14.32.32.32h1.49c.18 0 .32-.14.32-.32V7.89c0-.18-.14-.32-.32-.32zm3.82 3h-1.49c-.18 0-.32.14-.32.32v1.71c0 .18.14.32.32.32h1.49c.18 0 .32-.14.32-.32v-1.71c0-.18-.14-.32-.32-.32zm-3.82-6H11.6c-.18 0-.32.14-.32.32v1.71c0 .18.14.32.32.32h1.49c.18 0 .32-.14.32-.32V4.89c0-.18-.14-.32-.32-.32zm3.82 6h-1.49c-.18 0-.32.14-.32.32v1.71c0 .18.14.32.32.32h1.49c.18 0 .32-.14.32-.32v-1.71c0-.18-.14-.32-.32-.32z" />
          </svg>
          Docker Compose
        </div>
      </div>

      {preview && (
        <div class="mt-8 text-center">
          <a href="/architecture" class="text-primary-600 hover:text-primary-700 font-medium">
            Learn more about the architecture
            <svg class="ml-1 inline-block h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      )}
    </div>
  </div>
</section>
